# Local Clean Core defaults: apps/portal + apps/api + PostgreSQL.

# Required PostgreSQL connection. Use local-only credentials here.
DATABASE_URL="postgresql://realestategear:change-me@localhost:5432/realestategear_dev?schema=public"

NODE_ENV=development
API_PORT=3001

# Portal and API origins.
FRONTEND_URL=http://localhost:3006
ALLOWED_ORIGINS=http://localhost:3006
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME="Example Realty"

# Required by the API. Replace locally and use a secret manager in production.
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d

# Agent API routes are fail-closed by default. Enable only when integrating a
# compatible external client.
AGENT_API_ENABLED=false

# Google agent OAuth callback origin. Must match the API allowlist exactly.
# In this kit the portal hosts Agent routes, so point this at the portal origin
# so Google sign-in returns to /login and the agent session is established there.
AGENT_HQ_URL=http://localhost:3006

# Optional Google web OAuth (authorization-code) used by agent sign-in.
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_WEB_CLIENT_SECRET=
# GOOGLE_WEB_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Public MLS visibility must match between the API and MLS worker. Keep false
# until board approval and the post-deploy property reindex are complete.
MLS_PUBLIC_DISPLAY_ENABLED=false

# Demo seeds require an exact non-production database target. Set this only in
# the shell where you intentionally run a guarded seed; never set in production.
# CONFIRM_DEMO_SEED=localhost:5432/realestategear_dev?schema=public

# Optional Redis cache. Keep explicitly disabled for the PostgreSQL-only default.
REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Optional Typesense. Leave TYPESENSE_HOST unset for PostgreSQL search.
# TYPESENSE_HOST=localhost
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=replace-with-a-typesense-key

# Optional transactional email.
# RESEND_API_KEY=replace-with-a-resend-key
# EMAIL_FROM=noreply@example.com

# Optional integrations used by explicitly enabled Agent API capabilities.
# OPENAI_API_KEY=replace-with-an-openai-key
# GOOGLE_CLIENT_ID=replace-with-a-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-a-google-client-secret
# GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-value
