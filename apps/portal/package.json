{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:shared": "npm --prefix ../.. run build:packages",
    "predev": "npm run build:shared",
    "prebuild": "npm run build:shared",
    "pretypecheck": "npm run build:shared",
    "pretest": "npm run build:shared",
    "gen:theme": "tsx scripts/gen-theme.mts",
    "dev": "npm run gen:theme && next dev --port 3006",
    "build": "npm run gen:theme && NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "start": "node scripts/start-standalone.mjs 3006",
    "start:e2e": "node scripts/start-standalone.mjs 3106",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@realestategear/api-client": "*",
    "@realestategear/tokens": "*",
    "@realestategear/ui": "*",
    "framer-motion": "^12.23.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.552.0",
    "next": "16.2.11",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
