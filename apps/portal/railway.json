{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/portal/Dockerfile"
  },
  "deploy": {
    "watchPaths": [
      "/apps/portal/**",
      "/packages/tokens/**",
      "/packages/ui/**",
      "package.json",
      "*lock",
      "tsconfig*"
    ],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": true
  }
}
