{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=portal"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=portal",
    "watchPaths": [
      "/apps/portal/**",
      "/packages/tokens/**",
      "/packages/ui/**",
      "package.json",
      "*lock",
      "tsconfig*"
    ],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": true
  }
}
