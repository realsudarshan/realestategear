# Database
DATABASE_URL="postgresql://username:changeme@localhost:5432/realestategear_dev"

# Logging
LOG_LEVEL=info
NODE_ENV=development

# ───────────── MLS sync — optional ─────────────
# Leave MLS_AUTH_TYPE unset to run with sync disabled (service boots idle).
# See docs/MLS_BOARD_SETUP.md for the full walkthrough (getting vendor
# credentials, discovering your board's ID prefix, adding a compliance
# policy entry). This connector works with any RESO Web API vendor —
# MLS Grid, Trestle, Bridge Interactive, Spark API, etc. — not just one.

# "static" (a long-lived bearer token, e.g. MLS Grid) or
# "oauth2_client_credentials" (client id/secret exchanged for a token that
# expires and is refreshed automatically, e.g. Trestle/Bridge/Spark).
MLS_AUTH_TYPE=static
MLS_BASE_URL=https://api.mlsgrid.com/v2

# Required when MLS_AUTH_TYPE=static
MLS_ACCESS_TOKEN=

# Required when MLS_AUTH_TYPE=oauth2_client_credentials
MLS_OAUTH_TOKEN_URL=
MLS_OAUTH_CLIENT_ID=
MLS_OAUTH_CLIENT_SECRET=
MLS_OAUTH_SCOPE=

# Required once MLS_AUTH_TYPE is set — the board this deployment syncs.
# Stored on Listing.mlsBoardId; must match apps/api's MLS_BOARD_ID exactly
# (two separate services, two separate env configs, same value).
MLS_BOARD_ID=

# Optional API query filter to narrow a many-board aggregator (e.g. MLS
# Grid's "OriginatingSystemName") to just your board. Omit both if your
# credential already implies the board scope (common for a single-board
# Trestle/Bridge/Spark license) — MLS_BOARD_SCOPE_VALUE defaults to
# MLS_BOARD_ID when the field is set but the value isn't.
MLS_BOARD_SCOPE_FIELD=
MLS_BOARD_SCOPE_VALUE=

# Optional vendor "viewable"/delete flag field (e.g. MLS Grid's
# "MlgCanView"). Omit if your vendor has none — removal then relies purely
# on StandardStatus.
MLS_VIEWABLE_FLAG_FIELD=

# Optional board ID prefix (e.g. "ACT" for ACTRIS via MLS Grid, D17). Must
# match apps/api's MLS_PREFIX exactly. Run `npm run sample-pull` to detect
# whether your board uses one.
MLS_PREFIX=

# Optional DB-key namespace (SyncCursor/MlsAgent/MlsOffice/MlsSyncFailure).
# Defaults to "mls" — doesn't need to match any vendor name.
MLS_PROVIDER_ID=

# Optional connector tuning (all have sensible defaults).
MLS_PAGE_SIZE=5000
MLS_TIMEOUT_MS=30000
MLS_MIN_REQUEST_INTERVAL_MS=500
MLS_MAX_RETRIES=3
MLS_RETRY_BASE_DELAY_MS=1000

# ───────────── Compliance / kill-switches ─────────────
# Public display is OFF unless explicitly enabled — flip only after working
# through docs/mls-compliance.md's sign-off checklist.
MLS_PUBLIC_DISPLAY_ENABLED=false
# Stop sync without a redeploy (default: sync runs).
MLS_SYNC_ENABLED=true

# ───────────── Portal logo/MLS photo storage (Cloudflare R2 or AWS S3) ─────────────
# Optional — photo download/re-hosting (D7) is skipped when unset, even with
# a static MLS_ACCESS_TOKEN configured above.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
