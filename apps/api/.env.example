# API runtime
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Required PostgreSQL connection
DATABASE_URL="postgresql://realestategear:change-me@localhost:5432/realestategear_dev?schema=public"

# Default public frontend: apps/portal on port 3006
FRONTEND_URL=http://localhost:3006
ALLOWED_ORIGINS=http://localhost:3006

# Required authentication secret
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d

# Fail closed unless the temporarily co-located Agent HQ is intentionally used.
AGENT_API_ENABLED=false

# Guard for intentional non-production demo seeds. Prefer exporting this only
# for the seed command instead of storing it in this file.
# CONFIRM_DEMO_SEED=localhost:5432/realestategear_dev?schema=public

# Optional Redis. Leave unset for the PostgreSQL-only default.
# REDIS_URL=redis://localhost:6379

# Optional Typesense. Leave TYPESENSE_HOST unset for PostgreSQL search fallback.
# TYPESENSE_HOST=localhost
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=replace-with-a-typesense-key

# Optional portal logo storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Optional MLS agent verification. Leave MLS_BOARD_ID unset to keep this flow
# disabled. Values must match the separately configured MLS worker.
MLS_BOARD_ID=
MLS_PREFIX=
MLS_PROVIDER_ID=
