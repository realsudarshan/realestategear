{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --reporter=verbose src/__tests__/unit",
    "test:integration": "vitest run --reporter=verbose src/__tests__/integration",
    "db:migrate": "npm run db:migrate --workspace=db",
    "db:demo:reset": "npm run seed:demo:reset --workspace=db",
    "typesense:migrate": "tsx scripts/typesense-migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@realestategear/portal-config": "*",
    "@prisma/adapter-pg": "^7.4.0",
    "bcrypt": "^6.0.0",
    "cache": "*",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "db": "*",
    "dotenv": "^16.3.1",
    "email": "*",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.1.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "openai": "^6.22.0",
    "pdf-parse": "^2.4.5",
    "search": "*",
    "tsx": "^4.21.0",
    "typesense": "^3.0.6"
  },
  "devDependencies": {
    "supertest": "^6.3.3",
    "vitest": "^4.1.5"
  }
}
