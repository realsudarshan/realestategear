{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "noEmit": true,
    "incremental": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["react", "react-dom", "node"],
    "baseUrl": "../..",
    "paths": {
      "@realestategear/tokens": ["packages/tokens/index.ts"],
      "@realestategear/tokens/*": ["packages/tokens/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
