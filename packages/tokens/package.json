{
  "name": "@realestategear/tokens",
  "version": "0.1.0",
  "description": "Brand-neutral design tokens and theme compiler for Real Estate Gear applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "preset.css", "palette.default.css", "README.md"],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js",
      "default": "./dist/cn.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./preset.css": "./preset.css",
    "./palette.default.css": "./palette.default.css"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "culori": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/culori": "^2.1.1"
  },
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realestategear/realestategear.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/realestategear/realestategear#readme",
  "bugs": "https://github.com/realestategear/realestategear/issues",
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-package-legal.mjs",
    "test": "node --import tsx --test theme.test.ts",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "prepack": "npm run test && npm run typecheck && npm run build"
  }
}
