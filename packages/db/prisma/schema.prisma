// schema.prisma - PostgreSQL production database
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────── Enums ───────────────

enum MemberRole {
  OWNER
  AGENT
  ASSISTANT
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOUSE
  MULTI_FAMILY
  LAND
  COMMERCIAL
}

enum ListingSource {
  MLS
  MANUAL
  ZILLOW
  REALTOR_COM
}

enum ListingStatus {
  ACTIVE
  PENDING
  SOLD
  WITHDRAWN
  EXPIRED
  COMING_SOON
}

enum AIActionStatus {
  PENDING
  APPROVED
  EXECUTING
  EXECUTED
  SENT
  DISMISSED
  SNOOZED
  FAILED
  EXPIRED
}

enum EventType {
  HOME_TOUR
  BUYER_CONSULTATION
  LISTING_CONSULTATION
  MEETING
  INSPECTION
  WALKTHROUGH
  CLOSING
  APPRAISAL
  OTHER
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InquirySource {
  PORTAL_ANONYMOUS
  PORTAL_AUTHENTICATED
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

enum InquiryDeliveryState {
  PENDING
  PROCESSING
  RETRY
  DELIVERED
  DEAD_LETTER
}

enum ClassificationDecision {
  POSITIVE
  NEGATIVE
}

enum ClassificationSource {
  INGESTION
  RECLASSIFICATION
  MANUAL
}

enum CollectionOverrideDecision {
  INCLUDE
  EXCLUDE
}

enum ClassificationRunMode {
  CHECK
  DIFF
  APPLY
}

enum ClassificationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────── Account & Members ───────────────

model Account {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           AccountMember[]
  users             User[]
  emailDeliveries   EmailDelivery[]
  portals           Portal[]
  contacts          Contact[]
  transactions      Transaction[]
  tasks             Task[]
  geographicAreas   GeographicArea[]
  classifications   PropertyClassification[]
  classificationRuns ClassificationRun[]
  mlsAccess         AccountMlsAccess[]
  listings          Listing[] // MANUAL-source listings only
  inquiries         Inquiry[]
  inquiryDeliveries InquiryDelivery[]
}

model AccountMember {
  id        String     @id @default(cuid())
  accountId String
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(OWNER)

  assignedContacts Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
}

model AccountMlsAccess {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mlsBoardId   String
  membershipId String
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  // Set by the daily mls-status-check cron when the roster shows this
  // membership's agent has gone inactive; cleared automatically if a later
  // run finds them active again. Grace period is read as "time since
  // flagged" (no fixed deadline) — see issue #205.
  flaggedInactiveAt DateTime?

  @@unique([accountId, mlsBoardId])
  @@index([accountId])
}

// ─────────────── Portal, Areas & Collections ───────────────

model Portal {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  customDomain      String? @unique
  accountId         String
  account           Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  themePresetId     String  @default("classic")
  logoUrl           String?
  agentDisplayName  String?
  agentPhone        String?
  agentEmail        String?
  agentHeadlineText String?
  isActive          Boolean @default(false)

  // Brokerage / IDX compliance. brokerageName + brokeragePhone display in the
  // portal footer per most IDX licensing agreements; both required to activate.
  brokerageName  String?
  brokeragePhone String?

  // Set when the test-inquiry flow successfully delivered a routing test to the
  // agent's email. Used by the launch checklist to gate activation.
  contactRoutingVerifiedAt DateTime?

  // Manual admin action (never automatic — see issue #205), set when a
  // portal is pulled for MLS compliance (e.g. the owning agent went
  // inactive with their broker past the grace period). Kept distinct from
  // isActive so the public site can tell "never launched" apart from "was
  // live, suspended" and render the right state for each.
  suspendedAt DateTime?

  collections      ListingCollection[]
  featuredListings PortalFeaturedListing[]
  inquiries        Inquiry[]
  users            User[]
  domains          PortalDomain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([isActive])
  @@index([accountId, isActive])
}

enum PortalDomainKind {
  APEX
  WWW
  SUBDOMAIN
}

enum PortalDomainStatus {
  PENDING
  VERIFIED
  SSL_PENDING
  ACTIVE
  FAILED
  REMOVED
}

// Verified custom domains for a portal. Distinct from Portal.customDomain, a
// raw, unverified @unique field retained for compatibility. A hostname only
// routes real traffic once it reaches ACTIVE here; Portal.customDomain is not
// used to authorize routing.
model PortalDomain {
  id       String             @id @default(cuid())
  portalId String
  portal   Portal             @relation(fields: [portalId], references: [id], onDelete: Cascade)
  hostname String             @unique
  kind     PortalDomainKind
  status   PortalDomainStatus @default(PENDING)

  // DNS TXT ownership proof, checked at "_realestategear-challenge.<hostname>".
  // Not a secret post-verification, but not returned by public endpoints.
  verificationToken String

  // 'manual' (DNS TXT verification, implemented) | 'cloudflare_for_saas'
  // (reserved for the future SSL-automation path in the platform plan, not
  // wired up yet). Plain string, not an enum, so adding a provider doesn't
  // need a migration — same reasoning as Account.plan.
  provider String @default("manual")

  // At most one canonical domain per portal, enforced in portalDomainService
  // (transactional unset-then-set) rather than a DB constraint — Prisma has
  // no declarative partial-unique-index support, and a hand-maintained one
  // here would drift silently from this file.
  canonical Boolean @default(false)

  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?
  activatedAt DateTime?
  removedAt   DateTime?

  @@index([portalId])
  @@index([status])
}

model GeographicArea {
  id          String  @id @default(cuid())
  accountId   String
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  definition  Json
  isPublished Boolean @default(false)
  position    Int     @default(0)

  memberships PropertyAreaMembership[]
  inquiries   Inquiry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, slug])
  @@index([accountId, isPublished, position])
}

model ListingCollection {
  id          String  @id @default(cuid())
  portalId    String
  portal      Portal  @relation(fields: [portalId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  predicate   Json
  isPublished Boolean @default(false)
  position    Int     @default(0)

  overrides CollectionManualOverride[]
  inquiries Inquiry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portalId, slug])
  @@index([portalId, isPublished, position])
}

model CollectionManualOverride {
  id           String                     @id @default(cuid())
  collectionId String
  collection   ListingCollection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  decision     CollectionOverrideDecision
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([collectionId, propertyId])
  @@index([propertyId, decision])
}

// ─────────────── Property & Listings ───────────────

/// Physical asset — address, specs, media. Does not change between listing periods.
model Property {
  id        String  @id @default(cuid())
  address   String
  city      String
  state     String
  zipCode   String
  latitude  Float?
  longitude Float?
  parcelId  String? @unique

  propertyType PropertyType?
  bedrooms     Int?
  bathrooms    Float?
  squareFeet   Int?
  lotSize      Float?
  yearBuilt    Int?

  // MLS-sourced. RESO's SubdivisionName is per-listing because RESO has no
  // Property entity; we do. MLS ingest copies rawData.SubdivisionName here on
  // first upsert. Dirty in raw form (case variants, abbreviations) — needs a
  // normalization pass when MLS data lands (tracked in TODOS.md).
  subdivision String?
  normalizedAttributes Json @default("{}")

  // MLS Grid PhotosChangeTimestamp last ingested — lets the media sync skip
  // re-downloading photos that haven't changed (decision D7 / Codex #9).
  photosSyncedAt DateTime?

  listings     Listing[]
  media        Media[]
  events       Event[]
  notes        Note[]
  aiActions    AIAction[]
  transactions Transaction[]
  areaMemberships PropertyAreaMembership[]
  classifications PropertyClassification[]
  collectionOverrides CollectionManualOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, state])
  @@index([city, subdivision])
  @@index([latitude, longitude])
  @@index([propertyType, bedrooms, bathrooms, squareFeet])
}

model PropertyAreaMembership {
  id          String                 @id @default(cuid())
  areaId      String
  area        GeographicArea         @relation(fields: [areaId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  decision    ClassificationDecision
  source      ClassificationSource
  confidence  Float
  evidence    Json
  classifierVersion String
  configHash  String
  manualOverride Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([areaId, propertyId])
  @@index([propertyId, decision])
  @@index([areaId, decision, manualOverride])
}

model PropertyClassification {
  id          String                 @id @default(cuid())
  accountId   String
  account     Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tagSlug     String
  decision    ClassificationDecision
  source      ClassificationSource
  confidence  Float
  evidence    Json
  classifierVersion String
  configHash  String
  manualOverride Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, propertyId, tagSlug])
  @@index([propertyId, decision])
  @@index([accountId, tagSlug, decision, manualOverride])
}

model ClassificationRun {
  id          String                  @id @default(cuid())
  accountId   String
  account     Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mode        ClassificationRunMode
  status      ClassificationRunStatus @default(RUNNING)
  configHash  String
  classifierVersion String
  cursor      String?
  processed   Int @default(0)
  changed     Int @default(0)
  diff        Json?
  error       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([accountId, startedAt])
  @@index([status, startedAt])
}

/// Market event — one per listing period. MLS listings are global; MANUAL listings are account-owned.
model Listing {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  source    ListingSource
  accountId String? // set only for MANUAL listings
  account   Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)

  mlsBoardId String?
  mlsId      String? // public-facing RESO ListingId (de-prefixed) — display/search only, NOT the upsert key
  listingKey String? @unique // immutable RESO ListingKey (stored prefixed) — the MLS-record upsert anchor (decision D17)
  slug       String? @unique

  listPrice Decimal?
  status    ListingStatus @default(ACTIVE)
  listDate  DateTime?
  closeDate DateTime?

  // IDX/VOW compliance (Lane F / D19): false when the MLS forbids public internet
  // display (e.g. RESO InternetEntireListingDisplayYN=false). Non-displayable
  // listings are kept for the agent's own records but excluded from the public
  // search index and portal feeds.
  idxDisplayable Boolean @default(true)

  imageUrl    String?
  description String?
  rawData     String? // vendor-specific raw fields

  listingAgentName  String?
  listingAgentEmail String?
  listingAgentPhone String?
  brokerageName     String?
  brokeragePhone    String?

  // Denormalized from Property for search performance
  bedrooms   Int?
  bathrooms  Float?
  squareFeet Int?

  inquiries         Inquiry[]
  favorites         UserFavorites[]
  featuredInPortals PortalFeaturedListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaxed from @@unique to @@index (decision D17): mlsId (RESO ListingId) is a
  // de-prefixed display value and is not guaranteed unique; listingKey is the unique anchor.
  @@index([mlsBoardId, mlsId])
  @@index([status])
  @@index([listPrice])
  @@index([propertyId])
  @@index([accountId])
  @@index([slug])
  @@index([listDate])
  @@index([status, listPrice, bedrooms])
}

model Media {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  url        String
  caption    String?
  order      Int?

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model PortalFeaturedListing {
  id        String  @id @default(cuid())
  portalId  String
  portal    Portal  @relation(fields: [portalId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position  Int

  @@unique([portalId, listingId])
  @@index([portalId])
}

// ─────────────── User & Auth ───────────────

model User {
  id                      String    @id @default(cuid())
  email                   String
  accountId               String
  account                 Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  portalId                String?
  portal                  Portal?   @relation(fields: [portalId], references: [id], onDelete: SetNull)
  password                String?
  firstName               String?
  lastName                String?
  phoneNumber             String?
  avatarUrl               String?
  // Kept for auth middleware backward compat; account-scoped access is via AccountMember.role
  role                    String    @default("USER")
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  marketingEmailsOptOutAt DateTime?

  // Portal relations
  favorites     UserFavorites[]
  inquiries     Inquiry[]
  savedSearches SavedSearch[]

  // Identity links to CRM and account membership
  contacts    Contact[]       @relation("UserContact")
  memberships AccountMember[]

  // Agent HQ relations — accessible via AccountMember.userId = User.id
  assignedTasks        Task[]             @relation("TaskAssignee")
  assignedTransactions Transaction[]      @relation("TransactionAgent")
  assignedEvents       Event[]            @relation("EventAgent")
  authoredNotes        Note[]             @relation("NoteAuthor")
  marketReports        MarketReport[]     @relation("ReportAgent")
  aiConversations      AIConversation[]   @relation("ConversationUser")
  connectedAccounts    ConnectedAccount[]
  authIdentities       AuthIdentity[]
  emailDeliveries      EmailDelivery[]

  // AI Copilot relations
  aiActions AIAction[]   @relation("UserAIActions")
  auditLogs AIAuditLog[] @relation("UserAIAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Partial unique indexes added via raw SQL in the init migration:
  //   UNIQUE (email) WHERE portalId IS NULL              — agent emails globally unique
  //   UNIQUE (portalId, email) WHERE portalId IS NOT NULL — consumer emails per portal

  @@index([accountId])
  @@index([portalId])
}

model EmailDelivery {
  id         String  @id @default(cuid())
  kind       String
  to         String
  subject    String
  providerId String?

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  /// (accountId, kind) sends once per account for a given kind, forever. Kinds
  /// meant to recur (per portal, per Stripe event, etc.) must suffix `kind`
  /// with a distinguishing id — see deliveryKind usage in lifecycleEmailService.ts.
  @@unique([accountId, kind])
  @@index([userId])
  @@index([kind])
  @@index([sentAt])
}

/// Sign-in identities (e.g. Google OAuth), separate from ConnectedAccount (Gmail/Calendar sync).
model AuthIdentity {
  id                String  @id @default(cuid())
  provider          String
  providerAccountId String
  email             String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserFavorites {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
}

model SavedSearch {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  criteria    Json
  lastRunAt   DateTime?
  resultCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────── Agent HQ CRM ───────────────

model ContactSubmission {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  inquiryType String
  message     String

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  createdAt DateTime @default(now())
}

model Contact {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type            String  @default("LEAD")
  firstName       String
  lastName        String
  email           String?
  normalizedEmail String?
  phone           String?
  company         String?
  source          String?
  stage           String  @default("NEW")
  tags            Json?
  avatarUrl       String?

  assignedMember   AccountMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  assignedMemberId String?

  user   User?   @relation("UserContact", fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  tracks             ContactTrack[]
  interactions       ContactInteraction[]
  transactionParties TransactionParty[]
  submissions        ContactSubmission[]
  tasks              Task[]
  notes              Note[]
  eventAttendees     EventAttendee[]
  discoveredContacts TransactionDiscoveredContact[]
  aiActions          AIAction[]
  inquiries          Inquiry[]

  // Denormalized activity fields for relationship memory scans
  lastInteractionAt DateTime?
  lastConsultAt     DateTime?
  lastEventAt       DateTime?
  nextTaskDueAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId])
  @@unique([accountId, normalizedEmail])
  @@index([accountId])
  @@index([type])
  @@index([stage])
  @@index([assignedMemberId])
  @@index([email])
  @@index([accountId, stage, updatedAt])
  @@index([accountId, type, stage])
  @@index([accountId, lastInteractionAt])
  @@index([accountId, nextTaskDueAt])
}

model ContactTrack {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  side      String
  stage     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([side])
  @@index([isActive])
  @@index([contactId, side, isActive])
}

model ContactInteraction {
  id         String   @id @default(cuid())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String
  type       String
  side       String?
  subject    String?
  body       String?
  occurredAt DateTime @default(now())
  duration   Int?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([contactId, type])
  @@index([contactId, side, occurredAt])
  @@index([occurredAt])
}

model Transaction {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           String
  stage          String    @default("PROSPECT")
  address        String?
  mlsId          String?
  listPrice      Decimal?
  salePrice      Decimal?
  commissionRate Float?
  closingDate    DateTime?
  notes          String?

  offerPrice         Decimal?
  sellerCreditAmount Decimal?
  sellerCreditNote   String?
  financingType      String?
  downPayment        Decimal?
  bankName           String?
  saleType           String?

  mutualDate                  DateTime?
  possessionDate              DateTime?
  loanApplicationDueDate      DateTime?
  submittedToListingAgentDate DateTime?

  earnestAmount       Decimal?
  earnestMoneyDueDate DateTime?

  inspectionDate            DateTime?
  inspectionContingencyDate DateTime?
  financingContingencyDate  DateTime?
  appraisalContingencyDate  DateTime?
  titleContingencyDate      DateTime?

  propertyType      String?
  occupancy         String?
  county            String?
  yearBuilt         Int?
  isNewConstruction Boolean?
  apnTaxId          String?
  otherOffersCount  Int?

  hasHoa             Boolean?
  hasHomeWarranty    Boolean?
  homeWarrantyPaidBy String?
  buyerType          String?
  accessInfo         String?

  assignedAgent   User?   @relation("TransactionAgent", fields: [assignedAgentId], references: [id])
  assignedAgentId String?

  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?

  template   TransactionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  parties            TransactionParty[]
  tasks              Task[]
  transactionNotes   Note[]
  events             Event[]
  milestones         TransactionMilestone[]
  documents          TransactionDocument[]
  syncRuns           TransactionSyncRun[]
  discoveredMessages TransactionDiscoveredMessage[]
  aiActions          AIAction[]

  driveFolderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([stage])
  @@index([type])
  @@index([closingDate])
  @@index([propertyId])
  @@index([assignedAgentId])
  @@index([templateId])
  @@index([accountId, stage, closingDate])
  @@index([accountId, stage, updatedAt])
}

model TransactionTemplate {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  milestones          MilestoneDefinition[]
  taskDefinitions     TemplateTaskDefinition[]
  eventDefinitions    TemplateEventDefinition[]
  documentDefinitions TemplateDocumentDefinition[]
  transactions        Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TemplateDocumentDefinition {
  id          String              @id @default(cuid())
  template    TransactionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  key         String
  label       String
  description String?
  sortOrder   Int
  required    Boolean             @default(true)

  documents TransactionDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model TransactionDocument {
  id                   String                      @id @default(cuid())
  transaction          Transaction                 @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId        String
  documentDefinition   TemplateDocumentDefinition? @relation(fields: [documentDefinitionId], references: [id], onDelete: SetNull)
  documentDefinitionId String?
  label                String
  status               String                      @default("MISSING")
  notes                String?

  matchedAttachment   TransactionDiscoveredAttachment? @relation(fields: [matchedAttachmentId], references: [id], onDelete: SetNull)
  matchedAttachmentId String?                          @unique
  matchedAt           DateTime?
  driveFileId         String?
  driveWebLink        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([status])
}

model MilestoneDefinition {
  id          String              @id @default(cuid())
  template    TransactionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  key         String
  label       String
  description String?
  sortOrder   Int
  required    Boolean             @default(true)

  taskDefinitions  TemplateTaskDefinition[]  @relation("TaskAnchorMilestone")
  eventDefinitions TemplateEventDefinition[] @relation("EventAnchorMilestone")
  milestones       TransactionMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

