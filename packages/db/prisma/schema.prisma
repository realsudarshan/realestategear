  toolType    String
  label       String
  reason      String?
  payload     Json
  previewData Json?

  contextType     String?
  contextEntityId String?

  sourceType     String?
  sourceId       String?
  workflowKey    String?
  idempotencyKey String?

  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
