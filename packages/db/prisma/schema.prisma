model InquiryDelivery {
  id             String               @id @default(cuid())
  inquiryId      String
  inquiry        Inquiry              @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind           String
  recipient      String
  payload        Json
  idempotencyKey String               @unique
  state          InquiryDeliveryState @default(PENDING)
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(5)
  nextAttemptAt  DateTime             @default(now())
  lockedAt       DateTime?
  deliveredAt    DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  providerId     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([state, nextAttemptAt])
  @@index([inquiryId])
  @@index([accountId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESO Web API synchronization state.
// ─────────────────────────────────────────────────────────────────────────────

/// Per-resource incremental watermark. `lastSyncAt` holds the greatest
/// ModificationTimestamp seen for the resource (decision D4) — the server's clock,
/// not the client's — so incremental pulls never skip records on clock skew.
model SyncCursor {
  id         String   @id @default(cuid())
  providerId String // e.g. "mlsgrid"
  resource   String // "Property" | "Member" | "Office"
  lastSyncAt DateTime // max(ModificationTimestamp) committed for this resource
  updatedAt  DateTime @updatedAt

  @@unique([providerId, resource])
}

/// MLS member roster, synced from MLS Grid's Member resource. Backs agent
/// onboarding verification (decision D8): a submitted MLS ID is matched here, and
/// on success an AccountMlsAccess row is written.
model MlsAgent {
  id           String    @id @default(cuid())
  providerId   String // "mlsgrid"
  externalId   String // MemberKey (prefixed, immutable)
  mlsId        String? // MemberMlsId (de-prefixed) — the ID agents enter at onboarding
  firstName    String?
  lastName     String?
  name         String?
  email        String?
  phone        String?
  stateLicense String?
  status       String? // "Active" | "Inactive" | ...
  officeKey    String?
  officeMlsId  String?
  rawData      Json?
  modifiedAt   DateTime?
  syncedAt     DateTime  @default(now())

  @@unique([providerId, externalId])
  @@index([mlsId])
  @@index([email])
}

/// MLS office roster, synced from MLS Grid's Office resource.
model MlsOffice {
  id         String    @id @default(cuid())
  providerId String
  externalId String // OfficeKey (prefixed)
  mlsId      String? // OfficeMlsId (de-prefixed)
  name       String?
  phone      String?
  address    String?
  city       String?
  zipCode    String?
  status     String?
  rawData    Json?
  modifiedAt DateTime?
  syncedAt   DateTime  @default(now())

  @@unique([providerId, externalId])
  @@index([mlsId])
}

/// Dead-letter capture for records that failed to process (decision D13). The
/// sync retries these with backoff so one poison record can't wedge or silently
/// drop the batch; the watermark still advances on the successful records.
model MlsSyncFailure {
  id          String   @id @default(cuid())
  providerId  String
  resource    String // "Property" | "Member" | "Office"
  externalId  String // ListingKey / MemberKey / OfficeKey of the failed record
  payload     Json // the raw record, so a retry needs no re-fetch
  error       String // last error message
  retryCount  Int      @default(0)
  lastTriedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([providerId, resource, externalId])
  @@index([resource, retryCount])
}
