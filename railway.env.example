# Railway API service variables
DATABASE_URL=${{Postgres.DATABASE_URL}}
API_PORT=${{PORT}}
NODE_ENV=production
LOG_LEVEL=info

# Public apps/portal origin. Replace example domains with deployed service URLs.
FRONTEND_URL=https://portal.example.com
ALLOWED_ORIGINS=https://portal.example.com

# Create these as Railway secrets; never commit their values.
JWT_SECRET=${{JWT_SECRET}}
JWT_EXPIRES_IN=7d

# Default is fail-closed. Set true only when intentionally deploying a compatible
# external client against this API.
AGENT_API_ENABLED=false

# Optional Redis. Keep disabled when not deployed.
REDIS_ENABLED=false
# REDIS_HOST=${{Redis.REDISHOST}}
# REDIS_PORT=${{Redis.REDISPORT}}
# REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
# REDIS_DB=0

# Optional Typesense. Omit all four when not deployed; PostgreSQL search remains
# available without it.
# TYPESENSE_HOST=${{Typesense.TYPESENSE_HOST}}
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=${{TYPESENSE_API_KEY}}

# Optional transactional email.
# RESEND_API_KEY=${{RESEND_API_KEY}}
# EMAIL_FROM=noreply@example.com

# Railway portal service variables
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_SITE_NAME="Example Realty"

# Railway MLS worker variables
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# NODE_ENV=production
# MLS_AUTH_TYPE=static
# MLS_BASE_URL=https://provider.example.com/reso/odata
# MLS_ACCESS_TOKEN=${{MLS_ACCESS_TOKEN}}
# MLS_BOARD_ID=replace-with-board-id
# MLS_PREFIX=
# MLS_PROVIDER_ID=
# MLS_PUBLIC_DISPLAY_ENABLED=false
# MLS_SYNC_ENABLED=false

# CONFIRM_DEMO_SEED is intentionally absent. Production demo seeding is disabled.
